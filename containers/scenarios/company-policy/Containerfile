# company-policy: a developer machine checked against layered company config
# from examples/company: the security baseline (locked rules, a custom key
# type, rules over waivers), the platform team layer and the project's
# lootr.toml with waivers (DUMMY secrets, generated at build time, carrying
# the canary). Expected:
# - locked rules report and cannot be waived: unencrypted SSH key, ~/.netrc
#   readable by others, the classic token in a committed .env, the ACME key;
# - waived: netrc-password (~/.netrc), env-secret-like (TEST_DB_PASSWORD);
# - the expired waiver for gh-token-in-file is ignored and reported as
#   waiver-expired (high in the baseline);
# - process-sudo-group is disabled by the team layer although the user is
#   in sudo; workflow-default-permissions is raised to medium.
FROM lootr-base
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-client \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 1000 --shell /bin/sh --groups sudo dev
COPY examples/company/baseline.toml examples/company/team-platform.toml /etc/lootr/
RUN set -eu; hooks=/usr/local/lib/lootr-scenario; mkdir -p "$hooks"; \
    printf '%s\n' --config /etc/lootr/baseline.toml --config /etc/lootr/team-platform.toml \
      --config /home/dev/project/lootr.toml > "$hooks/args"; \
    { \
      echo "TEST_DB_PASSWORD=LOOTRCANARY-Wq3Zr8Tn5Vb2Kx7Mp4"; \
      echo "ACME_KEY=acme_live_LOOTRCANARYa1b2c3d4e5f6g"; \
    } > "$hooks/env"; \
    chmod 644 "$hooks/args" "$hooks/env"
COPY --chown=dev:dev examples/company/project.toml /home/dev/project/lootr.toml
USER dev
WORKDIR /home/dev/project
RUN set -eu; umask 077; c="DUMMY test only LOOTRCANARY"; \
    mkdir -p ~/.ssh ~/.config/gh .git .github/workflows; \
    ssh-keygen -q -t ed25519 -N "" -C "$c" -f ~/.ssh/id_ed25519; \
    printf 'machine mirror.acme.example login build password LOOTRCANARY-Pm4Xs8Lq2Vn6Rt\n' > ~/.netrc; \
    chmod 644 ~/.netrc; \
    printf 'github.com:\n    oauth_token: %s\n    user: dev\n' \
      "$(gen-github-token gho_ LOOTRCANARYcompanyGh0123456789)" > ~/.config/gh/hosts.yml; \
    printf 'ref: refs/heads/main\n' > .git/HEAD; \
    printf 'GH_TOKEN=%s\nLOG_LEVEL=debug\n' \
      "$(gen-github-token ghp_ LOOTRCANARYcompanyPat012345678)" > .env; \
    printf '%s\n' 'name: CI' 'on: [push]' 'jobs:' '  test:' '    runs-on: ubuntu-latest' \
      '    steps:' '      - run: make test' > .github/workflows/ci.yml
