#!/bin/sh
# Prints a dummy GitHub token with a valid checksum, for container scenarios:
#   gen-github-token <prefix> <random>     e.g. gen-github-token ghp_ LOOTRCANARY...
# <random> must be 30 base62 characters (use the canary). The checksum is the
# CRC32 of <random> in base62 (0-9A-Za-z), zero padded to 6 characters, as
# lootr::testing::github_token computes it. CRC32 comes from the gzip trailer
# (little endian, read with od on a little-endian machine).
set -eu
prefix=$1
random=$2
if [ "${#random}" -ne 30 ]; then
    echo "gen-github-token: the random part must be 30 characters" >&2
    exit 2
fi
crc=$(printf '%s' "$random" | gzip -c | tail -c 8 | head -c 4 | od -An -tu4 | tr -d ' \n')
alphabet=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz
checksum=""
i=0
while [ "$i" -lt 6 ]; do
    digit=$((crc % 62))
    crc=$((crc / 62))
    checksum="$(printf '%s' "$alphabet" | cut -c $((digit + 1)))$checksum"
    i=$((i + 1))
done
printf '%s%s%s\n' "$prefix" "$random" "$checksum"
